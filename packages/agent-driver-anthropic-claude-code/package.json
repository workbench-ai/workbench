{
  "name": "@workbench-ai/agent-driver-anthropic-claude-code",
  "version": "0.0.44",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workbench-ai/workbench.git",
    "directory": "packages/agent-driver-anthropic-claude-code"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workbench-auth": {
      "types": "./dist/workbench-auth.d.ts",
      "default": "./dist/workbench-auth.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check 'src/**/*.ts'"
  },
  "dependencies": {
    "@workbench-ai/agent-driver": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
