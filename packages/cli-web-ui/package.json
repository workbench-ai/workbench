{
  "name": "@workbench-ai/cli-web-ui",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./styles.css": "./styles.css",
    "./spreadsheet-viewer.css": "./spreadsheet-viewer.css",
    "./spreadsheet-viewer": {
      "types": "./spreadsheet-viewer.ts",
      "default": "./spreadsheet-viewer.ts"
    },
    "./components.json": "./components.json",
    "./lib/*": {
      "types": "./lib/*.ts",
      "default": "./lib/*.ts"
    },
    "./components/shared/*": {
      "types": "./components/shared/*.tsx",
      "default": "./components/shared/*.tsx"
    },
    "./components/ui/*": {
      "types": "./components/ui/*.tsx",
      "default": "./components/ui/*.tsx"
    }
  },
  "scripts": {
    "build": "node ./scripts/verify-shadcn-consumers.mjs && tsc -p tsconfig.json --noEmit",
    "design:lint": "node ./scripts/lint-design-md.mjs",
    "lint": "node ./scripts/verify-shadcn-consumers.mjs && tsc -p tsconfig.json --noEmit",
    "shadcn:consumers": "node ./scripts/verify-shadcn-consumers.mjs",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@workbench-ai/agent-driver": "workspace:*",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/libre-caslon-display": "^5.2.7",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.5.207",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "recharts": "3.8.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.0.1",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workbench-ai/workbench.git",
    "directory": "packages/cli-web-ui"
  }
}
