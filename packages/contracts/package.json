{
  "name": "@workbench-ai/flow-contracts",
  "version": "0.0.44",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workbench-ai/workbench.git",
    "directory": "packages/contracts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflow-validator-cli": {
      "types": "./dist/workflow-validator-cli.d.ts",
      "default": "./dist/workflow-validator-cli.js"
    }
  },
  "bin": {
    "flow-workflow-validator": "bin/flow-workflow-validator.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-paths.mjs dist && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --check 'src/**/*.ts'",
    "workflow:validate": "node dist/workflow-validator-cli.js"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
