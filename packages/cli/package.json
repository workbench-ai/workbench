{
  "name": "@workbench-ai/workbench",
  "version": "0.0.226",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workbench-ai/workbench.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bin": {
    "workbench": "dist/workbench.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod 755 dist/workbench.js && node ./scripts/build-dev-open-assets.mjs",
    "lint": "tsc -p tsconfig.lint.json",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.ts tests/cli.test.ts"
  },
  "dependencies": {
    "@workbench-ai/agent-driver": "workspace:*",
    "@workbench-ai/agent-driver-openai-codex": "workspace:*",
    "@workbench-ai/workbench-built-in-adapters": "workspace:*",
    "@workbench-ai/workbench-contract": "workspace:*",
    "@workbench-ai/workbench-core": "workspace:*",
    "skills": "1.5.12",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24.3.1",
    "@workbench-ai/workbench-ui": "workspace:*",
    "esbuild": "^0.27.2",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
